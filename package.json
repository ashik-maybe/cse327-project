{
  "name": "campbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend:dev": "bun run -C apps/backend dev",
    "frontend:dev": "bun run -C apps/frontend dev",
    "db:generate": "bun run -C apps/backend db:generate",
    "db:migrate": "bun run -C apps/backend db:migrate",
    "db:seed": "bun run -C apps/backend db:seed"
  },
  "dependencies": {
    "@campbridge/shared": "workspace:*"
  }
}

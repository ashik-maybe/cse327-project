{
  "name": "campbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend:dev": "cd apps/backend && bun run dev",
    "frontend:dev": "cd apps/frontend && bun run dev",
    "db:generate": "cd apps/backend && bun run db:generate",
    "db:migrate": "cd apps/backend && bun run db:migrate",
    "db:seed": "cd apps/backend && bun run db:seed"
  },
  "dependencies": {
    "@campbridge/shared": "workspace:*"
  }
}

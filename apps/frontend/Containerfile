# Build with Bun against the workspace lockfile, then run the Next.js server
# on the same glibc base so the native SWC binary installed at build time works.
FROM oven/bun:1 AS builder
WORKDIR /app

COPY package.json bun.lock ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/frontend/package.json ./apps/frontend/
COPY apps/backend/package.json ./apps/backend/

RUN bun install --frozen-lockfile

COPY packages/shared ./packages/shared
COPY apps/frontend ./apps/frontend

WORKDIR /app/apps/frontend
ARG BACKEND_URL=http://api:4000
ENV BACKEND_URL=$BACKEND_URL
RUN bun run build

FROM node:20-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_PUBLIC_API_BASE_URL=/api
ENV AUTH_COOKIE_NAME=campbridge_session

COPY --from=builder /app /app

EXPOSE 3000
CMD ["npm", "start"]
